@model QuizPlayViewModel
@{
    ViewData["Title"] = Model.Quiz.Title;

    string Shuffled(IEnumerable<AnswerChoice> choices, int questionId)
    {
        // Blander svarmulighederne deterministisk pr. spoergsmaal, saa raekkefoelgen
        // ikke afsloerer det korrekte svar (vigtigt for rækkefølge-opgaver).
        var list = choices.OrderBy(c => (c.Id * 2654435761u + (uint)questionId * 40503u) % 100000u).ToList();
        return string.Join(",", list.Select(c => c.Id));
    }

    string Bogstav(int i) => ((char)('A' + i)).ToString();
}

<div class="game-top" data-reveal>
    <span class="section-kicker">På sporet</span>
    <h1>@Model.Quiz.Title</h1>
    <p class="text-muted">
        @Model.Questions.Count spørgsmål, ét felt ad gangen.@(string.IsNullOrWhiteSpace(Model.Quiz.Description) ? "" : " " + Model.Quiz.Description)
    </p>
    <span class="step-count" data-step-count><b>1</b> af @Model.Questions.Count &middot; spørgsmål</span>
</div>

<div class="board" role="group" aria-label="Fremdrift på brættet">
    <div class="board-pawn" aria-hidden="true">
        <svg viewBox="0 0 32 32">
            <circle cx="16" cy="8" r="5.4" fill="#2F5BEA" stroke="#1B2A4A" stroke-width="2" />
            <path d="M16 13.4c5.2 0 9.2 3.7 9.2 8.4 0 3.4-2.5 5.6-6.2 5.6H13c-3.7 0-6.2-2.2-6.2-5.6 0-4.7 4-8.4 9.2-8.4z" fill="#2F5BEA" stroke="#1B2A4A" stroke-width="2" />
        </svg>
    </div>
    @{ var felt = 0; }
    @foreach (var _ in Model.Questions)
    {
        felt++;
        <button type="button" class="board-cell" data-goto="@(felt - 1)" aria-label="Gå til spørgsmål @felt">@felt</button>
    }
    <span class="board-label">Din brik flytter sig ét felt ad gangen</span>
</div>

<p class="step-progress-text" data-step-live aria-live="polite">Spørgsmål 1 af @Model.Questions.Count</p>

<form asp-action="Submit" asp-route-id="@Model.Quiz.Id" method="post" id="quizForm" novalidate>
    @Html.AntiForgeryToken()

    <div class="quiz-shell" data-stepper>
        @{
            var temaer = new[] { "skole", "familie", "natur", "teknologi", "samfund" };
            var number = 0;
        }
        @foreach (var q in Model.Questions)
        {
            number++;
            var k = 0;
            var tema = "t-" + temaer[(number - 1) % temaer.Length];
            <section class="q-step" aria-label="Spørgsmål @number">
                <div class="q-card @tema">
                    <div class="q-card-head">
                        <span class="q-num" aria-hidden="true">@number</span>
                        <span class="q-points">@q.Points point</span>
                    </div>
                    <h2 class="q-text"><span class="visually-hidden">Spørgsmål @number: </span>@q.Text</h2>

                    <div class="q-body">
                        @switch (q.Type)
                        {
                            case QuestionType.MultipleChoiceSingleAnswer:
                                k = 0;
                                foreach (var c in q.AnswerChoices.OrderBy(c => c.OrderIndex))
                                {
                                    <div class="choice">
                                        <input type="radio" name="choice_@q.Id" id="c_@c.Id" value="@c.Id" />
                                        <label for="c_@c.Id"><span class="choice-key">@Bogstav(k)</span><span>@c.Text</span></label>
                                    </div>
                                    { k++; }
                                }
                                break;

                            case QuestionType.TrueFalse:
                                k = 0;
                                foreach (var c in q.AnswerChoices.OrderBy(c => c.OrderIndex))
                                {
                                    <div class="choice">
                                        <input type="radio" name="choice_@q.Id" id="c_@c.Id" value="@c.Id" />
                                        <label for="c_@c.Id"><span class="choice-key">@Bogstav(k)</span><span>@c.Text</span></label>
                                    </div>
                                    { k++; }
                                }
                                break;

                            case QuestionType.ImageChoice:
                                <div class="image-grid">
                                    @{ k = 0; }
                                    @foreach (var c in q.AnswerChoices.OrderBy(c => c.OrderIndex))
                                    {
                                        <div class="choice choice-image">
                                            <input type="radio" name="choice_@q.Id" id="c_@c.Id" value="@c.Id" />
                                            <label for="c_@c.Id">
                                                @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                                {
                                                    <img src="@c.ImageUrl" alt="" loading="lazy" />
                                                }
                                                <span class="cap"><span class="choice-key">@Bogstav(k)</span><span>@c.Text</span></span>
                                            </label>
                                        </div>
                                        { k++; }
                                    }
                                </div>
                                break;

                            case QuestionType.MultipleChoiceMultipleAnswers:
                                <p class="q-hint">Der kan være flere rigtige svar &ndash; sæt kryds ved dem alle.</p>
                                k = 0;
                                foreach (var c in q.AnswerChoices.OrderBy(c => c.OrderIndex))
                                {
                                    <div class="choice">
                                        <input type="checkbox" name="choices_@q.Id" id="c_@c.Id" value="@c.Id" />
                                        <label for="c_@c.Id"><span class="choice-key">@Bogstav(k)</span><span>@c.Text</span></label>
                                    </div>
                                    { k++; }
                                }
                                break;

                            case QuestionType.ShortAnswer:
                                <label class="visually-hidden" for="q_@q.Id">Skriv dit svar</label>
                                <input class="slot" type="text" name="q_@q.Id" id="q_@q.Id" autocomplete="off" placeholder="Skriv dit svar" />
                                break;

                            case QuestionType.NumericAnswer:
                                <label class="visually-hidden" for="q_@q.Id">Skriv dit tal</label>
                                <input class="slot" type="text" inputmode="decimal" name="q_@q.Id" id="q_@q.Id" autocomplete="off" placeholder="Skriv tallet" />
                                break;

                            case QuestionType.Ordering:
                                var order = Shuffled(q.AnswerChoices, q.Id);
                                <p class="q-hint">Brug pilene til at sætte rækkefølgen &ndash; brikkerne glider på plads.</p>
                                <input type="hidden" name="order_@q.Id" id="order_@q.Id" value="@order" />
                                <ul class="ordering" data-target="order_@q.Id" id="olist_@q.Id">
                                    @{ var pos = 0; }
                                    @foreach (var c in q.AnswerChoices.OrderBy(c => (c.Id * 2654435761u + (uint)q.Id * 40503u) % 100000u))
                                    {
                                        pos++;
                                        <li data-id="@c.Id">
                                            <span class="pos">@pos</span>
                                            <span class="label">@c.Text</span>
                                            <span class="d-flex gap-1">
                                                <button type="button" class="btn-move move-up" aria-label="Flyt &quot;@c.Text&quot; op">&uarr;</button>
                                                <button type="button" class="btn-move move-down" aria-label="Flyt &quot;@c.Text&quot; ned">&darr;</button>
                                            </span>
                                        </li>
                                    }
                                </ul>
                                break;

                            case QuestionType.MatchingPairs:
                                var rights = q.AnswerChoices
                                    .Select(c => QuizScoring.SplitPair(c.Text).Right)
                                    .OrderBy(r => r.GetHashCode() * 31 + q.Id)
                                    .ToList();
                                <p class="q-hint">Vælg det rigtige makkerpar for hver brik.</p>
                                @foreach (var left in q.AnswerChoices.OrderBy(c => c.OrderIndex))
                                {
                                    <div class="match-row">
                                        <strong>@QuizScoring.SplitPair(left.Text).Left</strong>
                                        <span class="arrow" aria-hidden="true">&rarr;</span>
                                        <select class="form-select" name="match_@q.Id@("_")@left.Id" aria-label="Vælg makker til @QuizScoring.SplitPair(left.Text).Left">
                                            <option value="">-- vælg --</option>
                                            @foreach (var r in rights)
                                            {
                                                <option value="@r">@r</option>
                                            }
                                        </select>
                                    </div>
                                }
                                break;
                        }
                    </div>
                </div>
            </section>
        }

        @* ---------------- Her samles navn, e-mail og telefon ---------------- *@
        <section class="q-step" data-kind="contact" aria-label="Dine oplysninger">
            <div class="q-card t-samfund">
                <div class="q-card-head">
                    <span class="q-num" aria-hidden="true">&check;</span>
                    <span class="q-points">Sidste felt</span>
                </div>
                <h2 class="q-text">Dine oplysninger</h2>

                <div class="q-body">
                    <div class="contact-note">
                        <span aria-hidden="true">&#9998;</span>
                        <span>
                            <b>Sådan bliver besvarelsen gemt</b>
                            Vi skal kun bruge dit navn. E-mail og telefon er valgfrie.
                        </span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="ParticipantName">Navn *</label>
                            <input class="form-control" id="ParticipantName" name="ParticipantName" required maxlength="100" autocomplete="name" placeholder="Dit navn" />
                            <p class="field-error" data-error="name" role="alert">Skriv dit navn, så besvarelsen kan gemmes.</p>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="Email">E-mail</label>
                            <input class="form-control" id="Email" name="Email" type="email" maxlength="200" autocomplete="email" placeholder="dig@eksempel.dk" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="Phone">Telefon</label>
                            <input class="form-control" id="Phone" name="Phone" maxlength="200" autocomplete="tel" placeholder="12 34 56 78" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="step-nav">
            <button type="button" class="btn btn-ghost" data-step-back hidden>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6" /></svg>
                Tilbage
            </button>
            <button type="button" class="btn btn-primary" data-step-next hidden>
                Næste
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            </button>
            <button type="submit" class="btn btn-primary btn-lg" data-step-submit>
                Aflever besvarelse
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
            </button>
        </div>
    </div>
</form>
