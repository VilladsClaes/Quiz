@model Quiz
@{
    ViewData["Title"] = "Rediger quiz";
}

<h1 class="h3 mb-4">Rediger quiz</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-8">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label" for="title">Titel</label>
        <input class="form-control" id="title" name="title" value="@Model.Title" required maxlength="200" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="description">Beskrivelse</label>
        <textarea class="form-control" id="description" name="description" rows="3" maxlength="1000">@Model.Description</textarea>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="isActive" name="isActive" value="true" @(Model.IsActive ? "checked" : "") />
        <label class="form-check-label" for="isActive">Aktiv (kan ses af deltagere)</label>
    </div>
    <button type="submit" class="btn btn-primary">Gem</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Tilbage</a>
</form>
